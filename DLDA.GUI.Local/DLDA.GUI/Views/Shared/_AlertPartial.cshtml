@*
/// <summary>
/// Global notification component for displaying system alerts and feedback.
/// Consolidates both TempData (for cross-request POST-redirect-GET flows) and ViewBag 
/// (for single-request validation or errors) to ensure uniform user feedback across the application.
/// </summary>
*@

@if (TempData["Success"] != null || ViewBag.Success != null)
{
    <div class="alert alert-success d-flex align-items-center" role="alert">
        <span class="me-2">✅</span>
        <div>@(TempData["Success"] ?? ViewBag.Success)</div>
    </div>
}

@if (TempData["Error"] != null || ViewBag.Error != null)
{
    <div class="alert alert-danger d-flex align-items-center" role="alert">
        <span class="me-2">❌</span>
        <div>@(TempData["Error"] ?? ViewBag.Error)</div>
    </div>
}