@model DLDA.GUI.Models.ErrorViewModel

@*
/// <summary>
/// Global error handling view. 
/// Presents a generic, user-friendly error message to prevent leaking sensitive stack traces 
/// or internal system architecture details to the end-user.
/// Exposes a correlation ID (RequestId) to allow IT support and developers to trace the exact 
/// failure context within the backend telemetry and logs.
/// </summary>
*@

@{
    ViewData["Title"] = "Fel";
}

<h1 class="text-danger">Ett fel inträffade.</h1>
<h2 class="text-danger">Tyvärr kunde inte din förfrågan behandlas just nu.</h2>

@if (Model?.ShowRequestId == true)
{
    <p>
        <strong>Request-ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<p>
    Försök igen eller kontakta administratören om problemet kvarstår.
</p>