@using DLDA.GUI.DTOs.Staff
@model StaffQuestionDto

@*
/// <summary>
/// Viewport-aware routing wrapper for the staff assessment interface.
/// By isolating the desktop and mobile views into separate partials rather than relying solely on CSS media queries, 
/// we accommodate the vastly different clinical UX requirements of each platform (e.g., side-by-side comparative analysis on desktop 
/// vs. focused, stacked cognitive-load reduction on mobile) without bloating the DOM or creating fragile responsive layouts.
/// </summary>
*@

@{
    ViewData["Title"] = "Fråga (personal)";
}

<link rel="stylesheet" href="~/css/StaffQuestion.css" />

<div class="container mt-4">
    <div class="only-desktop">
        @await Html.PartialAsync("_DesktopStaffQuestion", Model)
    </div>

    <div class="only-mobile">
        @await Html.PartialAsync("_MobileStaffQuestion", Model)
    </div>
</div>